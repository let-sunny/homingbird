{
  "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
  "files": {
    "ignore": [
      "**/dist",
      "**/coverage",
      "**/reports",
      "**/.stryker-tmp",
      "**/node_modules",
      "packages/mod/.claude-plugin/types",
      "packages/mod/cli",
      "packages/mod/hooks/character-rules.mjs",
      "**/*.css",
      "assets",
      "deploy",
      ".claude/worktrees"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 110
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded"
    }
  },
  "linter": {
    "rules": {
      "recommended": true,
      "suspicious": {
        "noExplicitAny": "off",
        "noShadowRestrictedNames": "off",
        "noAssignInExpressions": "off",
        "noConfusingVoidType": "off"
      },
      "style": {
        "noNonNullAssertion": "off",
        "noParameterAssign": "off",
        "useImportType": "error"
      },
      "complexity": {
        "noBannedTypes": "off",
        "noForEach": "off"
      },
      "correctness": {
        "useYield": "off",
        "noInvalidUseBeforeDeclaration": "off"
      }
    }
  }
}
