# Settings for docker-compose.yml: copy this file to .env and fill it in.
# Every variable Dovecote reads is listed here; docker-compose.yml passes the whole file to the server.
# What each one means: docs/deployment.md#configuration. A blank value counts as unset.

# Required.
HB_PUBLIC_URL=https://homingbird.example.com
HB_OIDC_CLIENT_ID=
HB_OIDC_CLIENT_SECRET=
HB_ADMIN_EMAILS=

# Sign-in.
HB_OIDC_ISSUER=https://accounts.google.com
HB_OIDC_LABEL=
HB_ALLOWED_DOMAINS=
HB_SESSION_DAYS=30
HB_AGENT_CREDENTIAL_DAYS=90

# Starting values: administrators change these in the web client afterwards.
HB_CONTACT_MODE=open
HB_CHANNELS=
HB_FEATURES=

# Insights. 1 shows every group, so a group of one shows that person's figures; 5 hides smaller groups.
HB_INSIGHTS_MINIMUM_GROUP=1
HB_QUICK_APPROVAL_SECONDS=3

# Database. Unset, compose uses SQLite in the dovecote-data volume.
# For the postgres profile: postgres://homingbird:homingbird@postgres:5432/homingbird
HB_DATABASE_URL=

# Behind a proxy: the number of proxies that append to X-Forwarded-For.
HB_TRUST_PROXY=0

# Records.
HB_LOGS=
HB_AUDIT_RETENTION_DAYS=
# Days to keep sent and discarded notes, at least 7. Blank keeps every note.
HB_NOTE_RETENTION_DAYS=
HB_AUDIT_STDOUT=
HB_ANALYTICS=off
HB_ANALYTICS_URL=
HB_ANALYTICS_KEY=

# Outside services. Leave blank for the defaults in docs/deployment.md.
HB_PUSH_HOSTS=
HB_SECRETS_KEY=
HB_WAKE_HOSTS=
HB_OAUTH_REDIRECT_HOSTS=
HB_OAUTH_CLIENT_METADATA_HOSTS=
HB_OAUTH_CLIENTS=

# Appearance: a directory inside the container, mounted by you.
HB_THEME_DIR=

# Leave these unset under compose: the image listens on 8080 and serves its own web client.
HB_PORT=
HB_WEB_DIR=

# Development login lets anyone who reaches the server sign in as anyone. Only with
# HB_PUBLIC_URL=http://localhost:8080, and only with the port bound to 127.0.0.1 as docker-compose.yml does.
HB_DEV_LOGIN=0
