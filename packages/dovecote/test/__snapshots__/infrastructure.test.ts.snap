  "CREATE TABLE IF NOT EXISTS channel_agent_teaching (agent_id TEXT NOT NULL, instruction TEXT NOT NULL, sources TEXT NOT NULL, updated_at INTEGER NOT NULL, PRIMARY KEY (agent_id))",
]
`;
