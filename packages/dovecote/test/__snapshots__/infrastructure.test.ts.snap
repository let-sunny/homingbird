// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`schema > generates stable DDL for mysql 1`] = `
[
  "CREATE TABLE IF NOT EXISTS schema_versions (version BIGINT NOT NULL, PRIMARY KEY (version))",
  "CREATE TABLE IF NOT EXISTS members (id VARCHAR(64) NOT NULL, email VARCHAR(400) NOT NULL, subject VARCHAR(400) NOT NULL, name VARCHAR(400) NOT NULL, profile MEDIUMTEXT NOT NULL, role VARCHAR(400) NOT NULL, status VARCHAR(400) NOT NULL, event_seq BIGINT NOT NULL, created_at BIGINT NOT NULL, last_seen_at BIGINT, PRIMARY KEY (id), UNIQUE INDEX members_email_idx (email), UNIQUE INDEX members_subject_idx (subject))",
  "CREATE TABLE IF NOT EXISTS settings (name VARCHAR(400) NOT NULL, value MEDIUMTEXT NOT NULL, PRIMARY KEY (name))",
  "CREATE TABLE IF NOT EXISTS credentials (id VARCHAR(64) NOT NULL, member_id VARCHAR(64) NOT NULL, kind VARCHAR(400) NOT NULL, name VARCHAR(400) NOT NULL, client VARCHAR(400) NOT NULL, token_hash VARCHAR(400) NOT NULL, refresh_hash VARCHAR(400), token_expires_at BIGINT NOT NULL, expires_at BIGINT NOT NULL, created_at BIGINT NOT NULL, last_used_at BIGINT, revoked_at BIGINT, PRIMARY KEY (id), UNIQUE INDEX credentials_token_hash_idx (token_hash), INDEX credentials_refresh_hash_idx (refresh_hash), INDEX credentials_member_id_idx (member_id))",
  "CREATE TABLE IF NOT EXISTS oauth_clients (id VARCHAR(64) NOT NULL, name VARCHAR(400) NOT NULL, redirect_uris MEDIUMTEXT NOT NULL, created_at BIGINT NOT NULL, PRIMARY KEY (id))",
  "CREATE TABLE IF NOT EXISTS auth_requests (id VARCHAR(64) NOT NULL, kind VARCHAR(400) NOT NULL, status VARCHAR(400) NOT NULL, secret_hash VARCHAR(400), user_code VARCHAR(400), member_id VARCHAR(64), detail MEDIUMTEXT NOT NULL, created_at BIGINT NOT NULL, expires_at BIGINT NOT NULL, PRIMARY KEY (id), INDEX auth_requests_secret_hash_idx (secret_hash), INDEX auth_requests_user_code_idx (user_code), INDEX auth_requests_expires_at_idx (expires_at))",
  "CREATE TABLE IF NOT EXISTS conversations (id VARCHAR(64) NOT NULL, kind VARCHAR(400) NOT NULL, title VARCHAR(400), pair_key VARCHAR(400), created_at BIGINT NOT NULL, last_activity_at BIGINT NOT NULL, PRIMARY KEY (id), UNIQUE INDEX conversations_pair_key_idx (pair_key))",
  "CREATE TABLE IF NOT EXISTS participants (conversation_id VARCHAR(64) NOT NULL, member_id VARCHAR(64) NOT NULL, PRIMARY KEY (conversation_id, member_id), INDEX participants_member_id_idx (member_id))",
  "CREATE TABLE IF NOT EXISTS notes (id VARCHAR(64) NOT NULL, conversation_id VARCHAR(64) NOT NULL, author_id VARCHAR(64) NOT NULL, status VARCHAR(400) NOT NULL, body MEDIUMTEXT NOT NULL, in_reply_to VARCHAR(64), origin VARCHAR(400) NOT NULL, agent_name VARCHAR(400), credential_id VARCHAR(64), created_at BIGINT NOT NULL, updated_at BIGINT NOT NULL, sent_at BIGINT, PRIMARY KEY (id), INDEX notes_conversation_id_status_sent_at_idx (conversation_id, status, sent_at), INDEX notes_author_id_status_idx (author_id, status), INDEX notes_in_reply_to_idx (in_reply_to))",
  "CREATE TABLE IF NOT EXISTS receipts (note_id VARCHAR(64) NOT NULL, member_id VARCHAR(64) NOT NULL, delivered_at BIGINT NOT NULL, read_at BIGINT, drafting_at BIGINT, replied_at BIGINT, PRIMARY KEY (note_id, member_id), INDEX receipts_member_id_replied_at_idx (member_id, replied_at))",
  "CREATE TABLE IF NOT EXISTS pickups (note_id VARCHAR(64) NOT NULL, credential_id VARCHAR(64) NOT NULL, picked_at BIGINT NOT NULL, PRIMARY KEY (note_id, credential_id))",
  "CREATE TABLE IF NOT EXISTS contacts (low_id VARCHAR(64) NOT NULL, high_id VARCHAR(64) NOT NULL, requested_by VARCHAR(64) NOT NULL, status VARCHAR(400) NOT NULL, created_at BIGINT NOT NULL, PRIMARY KEY (low_id, high_id), INDEX contacts_high_id_idx (high_id))",
  "CREATE TABLE IF NOT EXISTS blocks (blocker_id VARCHAR(64) NOT NULL, blocked_id VARCHAR(64) NOT NULL, created_at BIGINT NOT NULL, PRIMARY KEY (blocker_id, blocked_id), INDEX blocks_blocked_id_idx (blocked_id))",
  "CREATE TABLE IF NOT EXISTS events (member_id VARCHAR(64) NOT NULL, seq BIGINT NOT NULL, created_at BIGINT NOT NULL, body MEDIUMTEXT NOT NULL, PRIMARY KEY (member_id, seq), INDEX events_created_at_idx (created_at))",
  "CREATE TABLE IF NOT EXISTS audit_log (id BIGINT AUTO_INCREMENT PRIMARY KEY, created_at BIGINT NOT NULL, actor_id VARCHAR(64), credential_id VARCHAR(64), credential_kind VARCHAR(400), action VARCHAR(400) NOT NULL, target VARCHAR(400), detail MEDIUMTEXT NOT NULL, INDEX audit_log_created_at_idx (created_at), INDEX audit_log_actor_id_idx (actor_id))",
  "CREATE TABLE IF NOT EXISTS push_subscriptions (endpoint_hash VARCHAR(400) NOT NULL, member_id VARCHAR(64) NOT NULL, endpoint MEDIUMTEXT NOT NULL, p256dh VARCHAR(400) NOT NULL, auth VARCHAR(400) NOT NULL, created_at BIGINT NOT NULL, PRIMARY KEY (endpoint_hash), INDEX push_subscriptions_member_id_idx (member_id))",
  "CREATE TABLE IF NOT EXISTS draft_requests (id VARCHAR(64) NOT NULL, member_id VARCHAR(64) NOT NULL, conversation_id VARCHAR(64) NOT NULL, in_reply_to VARCHAR(64), instruction MEDIUMTEXT NOT NULL, agent_id VARCHAR(64), created_at BIGINT NOT NULL, expires_at BIGINT NOT NULL, cancelled_at BIGINT, PRIMARY KEY (id), INDEX draft_requests_member_id_expires_at_idx (member_id, expires_at))",
  "CREATE TABLE IF NOT EXISTS draft_request_answers (request_id VARCHAR(64) NOT NULL, note_id VARCHAR(64) NOT NULL, credential_id VARCHAR(64) NOT NULL, PRIMARY KEY (request_id, note_id))",
]
`;

