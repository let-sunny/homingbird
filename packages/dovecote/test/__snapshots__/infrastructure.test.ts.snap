  "CREATE INDEX IF NOT EXISTS releases_member_id_created_at_idx ON releases (member_id, created_at)",
  "CREATE INDEX IF NOT EXISTS releases_created_at_idx ON releases (created_at)",
  "ALTER TABLE notes ADD COLUMN debate_id VARCHAR(64)",
  "CREATE TABLE IF NOT EXISTS debates (id VARCHAR(64) NOT NULL, question TEXT NOT NULL, visibility VARCHAR(400) NOT NULL, status VARCHAR(400) NOT NULL, created_by VARCHAR(64) NOT NULL, turns_per_agent BIGINT NOT NULL, total_turns BIGINT NOT NULL, minutes BIGINT NOT NULL, turn_characters BIGINT NOT NULL, created_at BIGINT NOT NULL, updated_at BIGINT NOT NULL, deadline_at BIGINT NOT NULL, concluded_at BIGINT, closed_at BIGINT, result TEXT, result_by VARCHAR(64), result_at BIGINT, result_round BIGINT NOT NULL, ended_because VARCHAR(400), PRIMARY KEY (id))",
  "CREATE INDEX IF NOT EXISTS debates_status_deadline_at_idx ON debates (status, deadline_at)",
  "CREATE INDEX IF NOT EXISTS debates_visibility_created_at_idx ON debates (visibility, created_at)",
  "CREATE TABLE IF NOT EXISTS debate_members (debate_id VARCHAR(64) NOT NULL, member_id VARCHAR(64) NOT NULL, created_at BIGINT NOT NULL, PRIMARY KEY (debate_id, member_id))",
  "CREATE INDEX IF NOT EXISTS debate_members_member_id_idx ON debate_members (member_id)",
  "CREATE TABLE IF NOT EXISTS debate_participants (debate_id VARCHAR(64) NOT NULL, member_id VARCHAR(64) NOT NULL, credential_id VARCHAR(64) NOT NULL, agent_name VARCHAR(400) NOT NULL, created_at BIGINT NOT NULL, PRIMARY KEY (debate_id, member_id))",
  "CREATE INDEX IF NOT EXISTS debate_participants_credential_id_idx ON debate_participants (credential_id)",
  "CREATE TABLE IF NOT EXISTS debate_turns (debate_id VARCHAR(64) NOT NULL, position BIGINT NOT NULL, member_id VARCHAR(64) NOT NULL, credential_id VARCHAR(64) NOT NULL, agent_name VARCHAR(400) NOT NULL, body TEXT NOT NULL, created_at BIGINT NOT NULL, PRIMARY KEY (debate_id, position))",
  "CREATE TABLE IF NOT EXISTS debate_approvals (debate_id VARCHAR(64) NOT NULL, member_id VARCHAR(64) NOT NULL, approved_at BIGINT NOT NULL, PRIMARY KEY (debate_id, member_id))",
  "CREATE TABLE IF NOT EXISTS debate_credits (debate_id VARCHAR(64) NOT NULL, member_id VARCHAR(64) NOT NULL, kind VARCHAR(400) NOT NULL, created_at BIGINT NOT NULL, PRIMARY KEY (debate_id, member_id, kind))",
  "CREATE INDEX IF NOT EXISTS debate_credits_member_id_idx ON debate_credits (member_id)",
  "ALTER TABLE debates ADD COLUMN votes_open_at BIGINT",
  "ALTER TABLE debates ADD COLUMN grace_minutes BIGINT",
  "ALTER TABLE debates ADD COLUMN dropped_out TEXT",
  "CREATE TABLE IF NOT EXISTS debate_drafts (debate_id VARCHAR(64) NOT NULL, round BIGINT NOT NULL, member_id VARCHAR(64) NOT NULL, credential_id VARCHAR(64) NOT NULL, result TEXT NOT NULL, created_at BIGINT NOT NULL, PRIMARY KEY (debate_id, round, member_id))",
  "CREATE TABLE IF NOT EXISTS debate_votes (debate_id VARCHAR(64) NOT NULL, round BIGINT NOT NULL, voter_id VARCHAR(64) NOT NULL, draft_by VARCHAR(64) NOT NULL, created_at BIGINT NOT NULL, PRIMARY KEY (debate_id, round, voter_id))",
  "CREATE TABLE IF NOT EXISTS audit_events (id BIGINT GENERATED ALWAYS AS IDENTITY PRIMARY KEY, created_at BIGINT NOT NULL, event VARCHAR(400) NOT NULL, outcome VARCHAR(400) NOT NULL, actor_id VARCHAR(64), credential_id VARCHAR(64), credential_kind VARCHAR(400), client_id VARCHAR(400), target_kind VARCHAR(400) NOT NULL, target_id VARCHAR(400), request_id VARCHAR(400), client_address VARCHAR(400), user_agent VARCHAR(400), detail TEXT NOT NULL, previous_hash VARCHAR(400) NOT NULL, hash VARCHAR(400) NOT NULL)",
  "CREATE INDEX IF NOT EXISTS audit_events_created_at_idx ON audit_events (created_at)",
  "CREATE INDEX IF NOT EXISTS audit_events_actor_id_idx ON audit_events (actor_id)",
  "CREATE INDEX IF NOT EXISTS audit_events_target_id_idx ON audit_events (target_id)",
  "CREATE INDEX IF NOT EXISTS audit_events_event_idx ON audit_events (event)",
  "CREATE TABLE IF NOT EXISTS audit_head (name VARCHAR(400) NOT NULL, last_id BIGINT NOT NULL, hash VARCHAR(400) NOT NULL, PRIMARY KEY (name))",
  "CREATE TABLE IF NOT EXISTS member_groups (id VARCHAR(64) NOT NULL, kind VARCHAR(400) NOT NULL, name VARCHAR(400), created_by VARCHAR(64), created_at BIGINT NOT NULL, PRIMARY KEY (id))",
  "CREATE TABLE IF NOT EXISTS group_members (group_id VARCHAR(64) NOT NULL, member_id VARCHAR(64) NOT NULL, PRIMARY KEY (group_id, member_id))",
  "CREATE INDEX IF NOT EXISTS group_members_member_id_idx ON group_members (member_id)",
  "ALTER TABLE channels ADD COLUMN manager_group_id VARCHAR(64)",
  "CREATE INDEX IF NOT EXISTS channels_manager_group_id_idx ON channels (manager_group_id)",
  "INSERT INTO member_groups (id, kind, created_by, created_at)
      SELECT REPLACE(c.conversation_id, 'conv_', 'grp_'), 'channel', c.created_by, c.created_at FROM channels c
      WHERE NOT EXISTS (SELECT 1 FROM member_groups x WHERE x.id = REPLACE(c.conversation_id, 'conv_', 'grp_'))",
  "INSERT INTO group_members (group_id, member_id)
      SELECT REPLACE(g.conversation_id, 'conv_', 'grp_'), g.member_id FROM channel_managers g
      JOIN participants p ON p.conversation_id = g.conversation_id AND p.member_id = g.member_id
      JOIN members m ON m.id = g.member_id
      WHERE m.status = 'active'
        AND EXISTS (SELECT 1 FROM member_groups x WHERE x.id = REPLACE(g.conversation_id, 'conv_', 'grp_'))
        AND NOT EXISTS (SELECT 1 FROM group_members y
          WHERE y.group_id = REPLACE(g.conversation_id, 'conv_', 'grp_') AND y.member_id = g.member_id)",
  "UPDATE channels SET manager_group_id = REPLACE(conversation_id, 'conv_', 'grp_')
      WHERE manager_group_id IS NULL
        AND EXISTS (SELECT 1 FROM member_groups x WHERE x.id = REPLACE(channels.conversation_id, 'conv_', 'grp_'))",
  "ALTER TABLE debate_turns ADD COLUMN agent_model VARCHAR(400)",
  "ALTER TABLE debate_drafts ADD COLUMN agent_model VARCHAR(400)",
  "ALTER TABLE debate_votes ADD COLUMN agent_model VARCHAR(400)",
  "ALTER TABLE members ADD COLUMN kind VARCHAR(400)",
  "UPDATE members SET kind = 'person' WHERE kind IS NULL",
  "ALTER TABLE notes ADD COLUMN approved_by VARCHAR(64)",
  "ALTER TABLE credentials ADD COLUMN issued_by VARCHAR(64)",
  "ALTER TABLE conversations ADD COLUMN channel_id VARCHAR(64)",
  "ALTER TABLE conversations ADD COLUMN asked_by VARCHAR(64)",
  "CREATE INDEX IF NOT EXISTS conversations_channel_id_idx ON conversations (channel_id)",
  "ALTER TABLE participants ADD COLUMN muted_at BIGINT",
  "ALTER TABLE members ADD COLUMN notifications VARCHAR(400)",
  "CREATE TABLE IF NOT EXISTS desk_wakes (member_id VARCHAR(64) NOT NULL, credential_id VARCHAR(64) NOT NULL, host VARCHAR(400) NOT NULL, sealed TEXT NOT NULL, enabled BIGINT NOT NULL, last_wake_at BIGINT, last_status VARCHAR(400) NOT NULL, failures BIGINT NOT NULL, retry_at BIGINT, stopped_because VARCHAR(400), created_at BIGINT NOT NULL, updated_at BIGINT NOT NULL, PRIMARY KEY (member_id))",
  "CREATE INDEX IF NOT EXISTS desk_wakes_credential_id_idx ON desk_wakes (credential_id)",
  "CREATE TABLE IF NOT EXISTS group_member_spans (group_id VARCHAR(64) NOT NULL, member_id VARCHAR(64) NOT NULL, joined_at BIGINT NOT NULL, left_at BIGINT, PRIMARY KEY (group_id, member_id, joined_at))",
  "CREATE INDEX IF NOT EXISTS group_member_spans_member_id_idx ON group_member_spans (member_id)",
  "INSERT INTO group_member_spans (group_id, member_id, joined_at, left_at)
      SELECT g.group_id, g.member_id, 0, NULL FROM group_members g
      WHERE NOT EXISTS (SELECT 1 FROM group_member_spans s
        WHERE s.group_id = g.group_id AND s.member_id = g.member_id AND s.left_at IS NULL)",
  "CREATE TABLE IF NOT EXISTS spent_refresh_tokens (refresh_hash VARCHAR(400) NOT NULL, credential_id VARCHAR(64) NOT NULL, spent_at BIGINT NOT NULL, replaced_by VARCHAR(400) NOT NULL, PRIMARY KEY (refresh_hash))",
  "CREATE INDEX IF NOT EXISTS spent_refresh_tokens_credential_id_idx ON spent_refresh_tokens (credential_id)",
  "CREATE TABLE IF NOT EXISTS history_answers (member_id VARCHAR(64) NOT NULL, conversation_id VARCHAR(64) NOT NULL, note_id VARCHAR(64) NOT NULL, answered_at BIGINT NOT NULL, PRIMARY KEY (member_id, conversation_id, note_id))",
  "CREATE INDEX IF NOT EXISTS history_answers_conversation_id_idx ON history_answers (conversation_id)",
  "ALTER TABLE notes ADD COLUMN sources TEXT",
  "ALTER TABLE notes ADD COLUMN discard_reason TEXT",
  "ALTER TABLE debates ADD COLUMN total_follows_agents BIGINT",
  "ALTER TABLE debate_turns ADD COLUMN after_turn BIGINT",
  "CREATE TABLE IF NOT EXISTS channel_agent_teaching (agent_id VARCHAR(64) NOT NULL, instruction TEXT NOT NULL, sources TEXT NOT NULL, updated_at BIGINT NOT NULL, PRIMARY KEY (agent_id))",
]
`;

