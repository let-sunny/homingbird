  "CREATE TABLE IF NOT EXISTS channel_answerers (conversation_id VARCHAR(64) NOT NULL, member_id VARCHAR(64) NOT NULL, PRIMARY KEY (conversation_id, member_id), INDEX channel_answerers_member_id_idx (member_id))",
  "CREATE TABLE IF NOT EXISTS channel_managers (conversation_id VARCHAR(64) NOT NULL, member_id VARCHAR(64) NOT NULL, PRIMARY KEY (conversation_id, member_id), INDEX channel_managers_member_id_idx (member_id))",
  "ALTER TABLE notes ADD COLUMN seen_at BIGINT",
  "ALTER TABLE notes ADD COLUMN decided_at BIGINT",
  "ALTER TABLE notes ADD COLUMN agent_body MEDIUMTEXT",
  "ALTER TABLE notes ADD COLUMN agent_client VARCHAR(400)",
  "ALTER TABLE notes ADD COLUMN agent_model VARCHAR(400)",
  "ALTER TABLE notes ADD COLUMN session_minutes BIGINT",
  "ALTER TABLE notes ADD COLUMN context_percent BIGINT",
  "CREATE INDEX notes_status_sent_at_idx ON notes (status, sent_at)",
  "CREATE INDEX notes_decided_at_idx ON notes (decided_at)",
  "CREATE TABLE IF NOT EXISTS principles (id VARCHAR(64) NOT NULL, member_id VARCHAR(64) NOT NULL, kind VARCHAR(400) NOT NULL, topic VARCHAR(400) NOT NULL, rule MEDIUMTEXT NOT NULL, source MEDIUMTEXT, place VARCHAR(400), enabled BIGINT NOT NULL, origin VARCHAR(400) NOT NULL, position BIGINT NOT NULL, created_at BIGINT NOT NULL, updated_at BIGINT NOT NULL, last_applied_at BIGINT, public_text MEDIUMTEXT, PRIMARY KEY (id), INDEX principles_member_id_idx (member_id))",
  "CREATE TABLE IF NOT EXISTS principle_applications (principle_id VARCHAR(64) NOT NULL, note_id VARCHAR(64) NOT NULL, member_id VARCHAR(64) NOT NULL, created_at BIGINT NOT NULL, missed_at BIGINT, PRIMARY KEY (principle_id, note_id), INDEX principle_applications_member_id_idx (member_id), INDEX principle_applications_note_id_idx (note_id))",
  "CREATE TABLE IF NOT EXISTS principle_offers (id VARCHAR(64) NOT NULL, member_id VARCHAR(64) NOT NULL, note_id VARCHAR(64) NOT NULL, conversation_id VARCHAR(64) NOT NULL, place VARCHAR(400), kind VARCHAR(400) NOT NULL, suggested_change MEDIUMTEXT, created_at BIGINT NOT NULL, closed_at BIGINT, PRIMARY KEY (id), INDEX principle_offers_member_id_created_at_idx (member_id, created_at))",
  "CREATE TABLE IF NOT EXISTS principle_quiet_places (member_id VARCHAR(64) NOT NULL, place VARCHAR(400) NOT NULL, created_at BIGINT NOT NULL, PRIMARY KEY (member_id, place))",
  "CREATE TABLE IF NOT EXISTS releases (note_id VARCHAR(64) NOT NULL, credential_id VARCHAR(64) NOT NULL, member_id VARCHAR(64) NOT NULL, conversation_id VARCHAR(64) NOT NULL, reason MEDIUMTEXT, created_at BIGINT NOT NULL, PRIMARY KEY (note_id, credential_id), INDEX releases_member_id_created_at_idx (member_id, created_at), INDEX releases_created_at_idx (created_at))",
  "ALTER TABLE notes ADD COLUMN debate_id VARCHAR(64)",
  "CREATE TABLE IF NOT EXISTS debates (id VARCHAR(64) NOT NULL, question MEDIUMTEXT NOT NULL, visibility VARCHAR(400) NOT NULL, status VARCHAR(400) NOT NULL, created_by VARCHAR(64) NOT NULL, turns_per_agent BIGINT NOT NULL, total_turns BIGINT NOT NULL, minutes BIGINT NOT NULL, turn_characters BIGINT NOT NULL, created_at BIGINT NOT NULL, updated_at BIGINT NOT NULL, deadline_at BIGINT NOT NULL, concluded_at BIGINT, closed_at BIGINT, result MEDIUMTEXT, result_by VARCHAR(64), result_at BIGINT, result_round BIGINT NOT NULL, ended_because VARCHAR(400), PRIMARY KEY (id), INDEX debates_status_deadline_at_idx (status, deadline_at), INDEX debates_visibility_created_at_idx (visibility, created_at))",
  "CREATE TABLE IF NOT EXISTS debate_members (debate_id VARCHAR(64) NOT NULL, member_id VARCHAR(64) NOT NULL, created_at BIGINT NOT NULL, PRIMARY KEY (debate_id, member_id), INDEX debate_members_member_id_idx (member_id))",
  "CREATE TABLE IF NOT EXISTS debate_participants (debate_id VARCHAR(64) NOT NULL, member_id VARCHAR(64) NOT NULL, credential_id VARCHAR(64) NOT NULL, agent_name VARCHAR(400) NOT NULL, created_at BIGINT NOT NULL, PRIMARY KEY (debate_id, member_id), INDEX debate_participants_credential_id_idx (credential_id))",
  "CREATE TABLE IF NOT EXISTS debate_turns (debate_id VARCHAR(64) NOT NULL, position BIGINT NOT NULL, member_id VARCHAR(64) NOT NULL, credential_id VARCHAR(64) NOT NULL, agent_name VARCHAR(400) NOT NULL, body MEDIUMTEXT NOT NULL, created_at BIGINT NOT NULL, PRIMARY KEY (debate_id, position))",
  "CREATE TABLE IF NOT EXISTS debate_approvals (debate_id VARCHAR(64) NOT NULL, member_id VARCHAR(64) NOT NULL, approved_at BIGINT NOT NULL, PRIMARY KEY (debate_id, member_id))",
  "CREATE TABLE IF NOT EXISTS debate_credits (debate_id VARCHAR(64) NOT NULL, member_id VARCHAR(64) NOT NULL, kind VARCHAR(400) NOT NULL, created_at BIGINT NOT NULL, PRIMARY KEY (debate_id, member_id, kind), INDEX debate_credits_member_id_idx (member_id))",
  "ALTER TABLE debates ADD COLUMN votes_open_at BIGINT",
  "ALTER TABLE debates ADD COLUMN grace_minutes BIGINT",
  "ALTER TABLE debates ADD COLUMN dropped_out MEDIUMTEXT",
  "CREATE TABLE IF NOT EXISTS debate_drafts (debate_id VARCHAR(64) NOT NULL, round BIGINT NOT NULL, member_id VARCHAR(64) NOT NULL, credential_id VARCHAR(64) NOT NULL, result MEDIUMTEXT NOT NULL, created_at BIGINT NOT NULL, PRIMARY KEY (debate_id, round, member_id))",
  "CREATE TABLE IF NOT EXISTS debate_votes (debate_id VARCHAR(64) NOT NULL, round BIGINT NOT NULL, voter_id VARCHAR(64) NOT NULL, draft_by VARCHAR(64) NOT NULL, created_at BIGINT NOT NULL, PRIMARY KEY (debate_id, round, voter_id))",
  "CREATE TABLE IF NOT EXISTS audit_events (id BIGINT AUTO_INCREMENT PRIMARY KEY, created_at BIGINT NOT NULL, event VARCHAR(400) NOT NULL, outcome VARCHAR(400) NOT NULL, actor_id VARCHAR(64), credential_id VARCHAR(64), credential_kind VARCHAR(400), client_id VARCHAR(400), target_kind VARCHAR(400) NOT NULL, target_id VARCHAR(400), request_id VARCHAR(400), client_address VARCHAR(400), user_agent VARCHAR(400), detail MEDIUMTEXT NOT NULL, previous_hash VARCHAR(400) NOT NULL, hash VARCHAR(400) NOT NULL, INDEX audit_events_created_at_idx (created_at), INDEX audit_events_actor_id_idx (actor_id), INDEX audit_events_target_id_idx (target_id), INDEX audit_events_event_idx (event))",
  "CREATE TABLE IF NOT EXISTS audit_head (name VARCHAR(400) NOT NULL, last_id BIGINT NOT NULL, hash VARCHAR(400) NOT NULL, PRIMARY KEY (name))",
  "CREATE TABLE IF NOT EXISTS member_groups (id VARCHAR(64) NOT NULL, kind VARCHAR(400) NOT NULL, name VARCHAR(400), created_by VARCHAR(64), created_at BIGINT NOT NULL, PRIMARY KEY (id))",
  "CREATE TABLE IF NOT EXISTS group_members (group_id VARCHAR(64) NOT NULL, member_id VARCHAR(64) NOT NULL, PRIMARY KEY (group_id, member_id), INDEX group_members_member_id_idx (member_id))",
  "ALTER TABLE channels ADD COLUMN manager_group_id VARCHAR(64)",
  "CREATE INDEX channels_manager_group_id_idx ON channels (manager_group_id)",
  "INSERT INTO member_groups (id, kind, created_by, created_at)
      SELECT REPLACE(c.conversation_id, 'conv_', 'grp_'), 'channel', c.created_by, c.created_at FROM channels c
      WHERE NOT EXISTS (SELECT 1 FROM member_groups x WHERE x.id = REPLACE(c.conversation_id, 'conv_', 'grp_'))",
  "INSERT INTO group_members (group_id, member_id)
      SELECT REPLACE(g.conversation_id, 'conv_', 'grp_'), g.member_id FROM channel_managers g
      JOIN participants p ON p.conversation_id = g.conversation_id AND p.member_id = g.member_id
      JOIN members m ON m.id = g.member_id
      WHERE m.status = 'active'
        AND EXISTS (SELECT 1 FROM member_groups x WHERE x.id = REPLACE(g.conversation_id, 'conv_', 'grp_'))
        AND NOT EXISTS (SELECT 1 FROM group_members y
          WHERE y.group_id = REPLACE(g.conversation_id, 'conv_', 'grp_') AND y.member_id = g.member_id)",
  "UPDATE channels SET manager_group_id = REPLACE(conversation_id, 'conv_', 'grp_')
      WHERE manager_group_id IS NULL
        AND EXISTS (SELECT 1 FROM member_groups x WHERE x.id = REPLACE(channels.conversation_id, 'conv_', 'grp_'))",
  "ALTER TABLE debate_turns ADD COLUMN agent_model VARCHAR(400)",
  "ALTER TABLE debate_drafts ADD COLUMN agent_model VARCHAR(400)",
  "ALTER TABLE debate_votes ADD COLUMN agent_model VARCHAR(400)",
  "ALTER TABLE members ADD COLUMN kind VARCHAR(400)",
  "UPDATE members SET kind = 'person' WHERE kind IS NULL",
  "ALTER TABLE notes ADD COLUMN approved_by VARCHAR(64)",
  "ALTER TABLE credentials ADD COLUMN issued_by VARCHAR(64)",
  "ALTER TABLE conversations ADD COLUMN channel_id VARCHAR(64)",
  "ALTER TABLE conversations ADD COLUMN asked_by VARCHAR(64)",
  "CREATE INDEX conversations_channel_id_idx ON conversations (channel_id)",
  "ALTER TABLE participants ADD COLUMN muted_at BIGINT",
  "ALTER TABLE members ADD COLUMN notifications VARCHAR(400)",
  "CREATE TABLE IF NOT EXISTS desk_wakes (member_id VARCHAR(64) NOT NULL, credential_id VARCHAR(64) NOT NULL, host VARCHAR(400) NOT NULL, sealed MEDIUMTEXT NOT NULL, enabled BIGINT NOT NULL, last_wake_at BIGINT, last_status VARCHAR(400) NOT NULL, failures BIGINT NOT NULL, retry_at BIGINT, stopped_because VARCHAR(400), created_at BIGINT NOT NULL, updated_at BIGINT NOT NULL, PRIMARY KEY (member_id), INDEX desk_wakes_credential_id_idx (credential_id))",
  "CREATE TABLE IF NOT EXISTS group_member_spans (group_id VARCHAR(64) NOT NULL, member_id VARCHAR(64) NOT NULL, joined_at BIGINT NOT NULL, left_at BIGINT, PRIMARY KEY (group_id, member_id, joined_at), INDEX group_member_spans_member_id_idx (member_id))",
  "INSERT INTO group_member_spans (group_id, member_id, joined_at, left_at)
      SELECT g.group_id, g.member_id, 0, NULL FROM group_members g
      WHERE NOT EXISTS (SELECT 1 FROM group_member_spans s
        WHERE s.group_id = g.group_id AND s.member_id = g.member_id AND s.left_at IS NULL)",
  "CREATE TABLE IF NOT EXISTS spent_refresh_tokens (refresh_hash VARCHAR(400) NOT NULL, credential_id VARCHAR(64) NOT NULL, spent_at BIGINT NOT NULL, replaced_by VARCHAR(400) NOT NULL, PRIMARY KEY (refresh_hash), INDEX spent_refresh_tokens_credential_id_idx (credential_id))",
  "CREATE TABLE IF NOT EXISTS history_answers (member_id VARCHAR(64) NOT NULL, conversation_id VARCHAR(64) NOT NULL, note_id VARCHAR(64) NOT NULL, answered_at BIGINT NOT NULL, PRIMARY KEY (member_id, conversation_id, note_id), INDEX history_answers_conversation_id_idx (conversation_id))",
  "ALTER TABLE notes ADD COLUMN sources MEDIUMTEXT",
  "ALTER TABLE notes ADD COLUMN discard_reason MEDIUMTEXT",
  "ALTER TABLE debates ADD COLUMN total_follows_agents BIGINT",
  "ALTER TABLE debate_turns ADD COLUMN after_turn BIGINT",
  "CREATE TABLE IF NOT EXISTS channel_agent_teaching (agent_id VARCHAR(64) NOT NULL, instruction MEDIUMTEXT NOT NULL, sources MEDIUMTEXT NOT NULL, updated_at BIGINT NOT NULL, PRIMARY KEY (agent_id))",
]
`;

