{
  "name": "@homingbird/cli",
  "version": "0.6.5",
  "description": "The homingbird command line and runner: connect any agent to Homingbird to read, draft and answer notes. You approve every note in the web client.",
  "license": "MIT",
  "author": "Minseon Kim (https://github.com/let-sunny)",
  "homepage": "https://let-sunny.github.io/homingbird/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/let-sunny/homingbird.git",
    "directory": "packages/cli"
  },
  "bugs": "https://github.com/let-sunny/homingbird/issues",
  "keywords": ["homingbird", "agents", "messenger", "cli"],
  "type": "module",
  "engines": { "node": ">=22" },
  "bin": { "homingbird": "./dist/homingbird.js" },
  "exports": { ".": "./src/index.ts" },
  "files": ["dist"],
  "publishConfig": {
    "access": "public",
    "exports": { "./package.json": "./package.json" }
  },
  "scripts": {
    "build": "tsx build.ts"
  },
  "devDependencies": {
    "@homingbird/client": "workspace:*",
    "@homingbird/kernel": "workspace:*",
    "@homingbird/protocol": "workspace:*"
  }
}
