<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>homingbird.runner.https-hb-example-com</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/node</string>
    <string>/usr/lib/node_modules/@homingbird/cli/dist/homingbird.js</string>
    <string>run</string>
    <string>--service</string>
    <string>--server</string>
    <string>https://hb.example.com</string>
    <string>--agent</string>
    <string>claude -p --model &quot;opus 5&quot; 100%</string>
    <string>--timeout</string>
    <string>120</string>
    <string>--split</string>
    <string>--reader</string>
    <string>claude -p --tools &apos;&apos; --strict-mcp-config</string>
    <string>--require-toolless-reader</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/home/june/work notes</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/home/june/.local/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>/Users/june/.config/homingbird/logs/runner-https-hb-example-com.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/june/.config/homingbird/logs/runner-https-hb-example-com.log</string>
</dict>
</plist>
